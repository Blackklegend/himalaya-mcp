{
  "name": "himalaya",
  "version": "2.1.2-hardened.1",
  "description": "Hardened fork: read-only defaults, explicit capabilities, preview-only drafts; delivery disabled.",
  "author": {
    "name": "Data-Wise"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_himalaya_email__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-send.sh\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
